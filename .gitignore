# --- Secrets ----------------------------------------------------------------
# The single most important rule of this file: no real configuration, ever.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Tooling ----------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Data -------------------------------------------------------------------
# The SQLite database contains conversation history and must never be committed.
data/

# --- Local artefacts --------------------------------------------------------
# Backups live outside the repository (BACKUP_DIR, D:\EmmaBackups); these
# patterns only catch copies that end up here by accident.
*.tar.gz
*.zip
*.log

# uv writes this when it installs; requirements.txt already pins every version
# exactly, and is what both the server and the guide use. Committing a second,
# richer lock file would leave two sources of truth free to disagree.
uv.lock

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
