# EMMA configuration.
#
# Copy this file to `.env` in the same directory and fill in the real values:
#
#     cp .env.example .env
#     chmod 600 .env
#
# `.env` holds secrets and is excluded from Git by .gitignore: never commit it,
# never paste it in an issue. Values already present in the process environment
# take precedence over the ones written here.

# --- Anthropic --------------------------------------------------------------

# REQUIRED. API key from https://console.anthropic.com (starts with "sk-ant-").
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL. Model used for every reply.
# Default: claude-sonnet-4-6 - best balance of quality and cost for a personal
# conversational assistant. More capable than Haiku, fast enough for chat, and
# cheap enough for light personal traffic.
# Any valid Anthropic model identifier works here.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Telegram ---------------------------------------------------------------

# REQUIRED. Token issued by @BotFather when you create the bot.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED. The one numeric user ID the bot answers to; anybody else is ignored
# without a reply. Ask @userinfobot for yours - it is a number, not a @handle.
TELEGRAM_ALLOWED_USER_ID=123456789

# --- Conversation -----------------------------------------------------------

# OPTIONAL. How many messages (user + assistant, so roughly half as many
# exchanges) stay in the rolling context window. Default: 20.
# Higher means more context and a higher cost per message.
MAX_HISTORY_MESSAGES=20

# OPTIONAL. Text file holding the assistant personality, sent as the system
# prompt at every call. A relative path is resolved from the project root.
# Default: prompts/system_prompt.txt
SYSTEM_PROMPT_PATH=prompts/system_prompt.txt

# --- Backup -----------------------------------------------------------------
# Read by scripts/backup.sh; the application itself never writes here.

# OPTIONAL. Where dated archives are written. Point it at a disk other than the
# system one - chapter 1 of docs/GUIDA.pdf shows how to mount a second drive.
# Default: /mnt/backup/emma
BACKUP_DIR=/mnt/backup/emma

# OPTIONAL. How many archives the rotation keeps; older ones are deleted.
# Default: 14 (two weeks of daily backups).
BACKUP_KEEP=14
